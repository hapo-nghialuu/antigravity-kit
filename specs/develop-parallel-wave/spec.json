  "scope_lock": {
    "source": "Parallel wave execution for hapo:develop: when a spec's task_registry contains independent tasks, dispatch multiple god-developer subagents concurrently, each in an isolated git worktree, grouped into dependency-ordered waves; per-task quality gate preserved; wave results merged back and spec state synced after each wave.",
    "in_scope": [
      "Opt-in parallel mode for hapo:develop Full-Spec execution (--parallel flag)",
      "Wave planning from task_registry.dependencies with single-writer-per-file conflict rule",
      "Per-task god-developer dispatch with Claude Code worktree isolation, background execution",
      "Per-task quality gate preserved (test-runner + code-auditor), post-merge integration check per wave",
      "Orchestrator-only spec-state sync (agents never write spec.json/task markdown)",
      "Sequential fallback when isolation is unavailable; runtime.json escape hatch",
      "Spike task verifying real worktree subagent merge semantics before behavior text is finalized",
      "Self-test assertions for the new/changed skill text"
    ],
    "out_of_scope": [
      "Parallelism for hapo:specs generation or any other skill",
      "New .cjs runtime hooks or installer changes beyond the runtime.json toggle",
      "OpenCode port of parallel mode",
      "Changing the sequential default behavior of hapo:develop",
      "Cross-spec (multi-feature) parallel scheduling"
    ],
    "expansion_policy": "requires-user-approval"
  },
