{
  "version": 2,
  "scope": "claude-only",
  "commands": {
    "core": [
      "docs.md",
      "spec-init.md",
      "spec-requirements.md",
      "spec-design.md",
      "spec-validate.md",
      "spec-tasks.md",
      "spec-status.md",
      "code.md",
      "test.md"
    ]
  },
  "skills": {
    "required": [
      "specs",
      "impact-analysis",
      "inspect",
      "code",
      "test",
      "code-review",
      "git",
      "develop",
      "hotfix",
      "sync",
      "research"
    ]
  },
  "agents": {
    "required": [
      "test-runner.md",
      "code-auditor.md",
      "god-developer.md",
      "debugger.md",
      "docs-keeper.md",
      "git-ops.md",
      "inspector.md",
      "battle-chief.md",
      "researcher.md",
      "spec-maker.md",
      "ui-ux-designer.md",
      "deployer.md"
    ]
  },
  "scripts": {
    "required": [
      "docs-fetch.js",
      "validate-docs.cjs"
    ]
  },
  "agentReferences": {
    "copyRecursive": true
  },
  "hooks": {
    "assumed": []
  },
  "runtime": {
    "files": [
      "runtime.json",
      "status.cjs",
      "hooks/session.cjs",
      "hooks/agent.cjs",
      "hooks/usage.cjs",
      "hooks/privacy-block.cjs",
      "hooks/inspect-block.cjs",
      "hooks/rules.cjs",
      "hooks/spec-state.cjs",
      "hooks/state.cjs",
      "hooks/lib/color.cjs",
      "hooks/lib/parser.cjs",
      "hooks/lib/counter.cjs",
      "hooks/lib/git.cjs",
      "hooks/lib/config.cjs",
      "hooks/lib/context.cjs",
      "hooks/lib/detect.cjs"
    ]
  },
  "settings": {
    "template": "settings/settings.json"
  }
}
