  try {
    const fileContents = fs.readFileSync(configPath, 'utf8');
    const config = yaml.load(fileContents);
    return config;
  } catch (e) {
    console.error('❌ Error reading .cafekit.yml:', e.message);
    return {};
  }
}

module.exports = readConfig;
```

**Task 7.2: Update install.js**
```javascript
const config = readConfig();

// Merge config with CLI args (CLI args take precedence)
const platform = argv.platform || config.platform;
const verbose = argv.verbose || config.verbose || false;
const force = argv.force || config.force || false;
```

